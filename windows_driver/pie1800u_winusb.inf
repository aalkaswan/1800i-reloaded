; pie1800u_winusb.inf - Modern 64-bit WinUSB Driver Setup for PrimeFilm 1800u/1800i
; Compatible with Windows 10 & Windows 11 (64-bit x64 / ARM64)
;
[Version]
Signature="$Windows NT$"
Class=USBDevice
ClassGUID={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ManufacturerName%
CatalogFile=pie1800u_winusb.cat
DriverVer=11/04/2026,1.0.0.0

[Manufacturer]
%ManufacturerName%=Standard,NTamd64.10.0,NTarm64.10.0

[Standard.NTamd64.10.0]
%DeviceName%=USB_Install, USB\VID_05E3&PID_0120

[Standard.NTarm64.10.0]
%DeviceName%=USB_Install, USB\VID_05E3&PID_0120

[USB_Install]
Include=winusb.inf
Needs=WINUSB.NT

[USB_Install.Services]
Include=winusb.inf
Needs=WINUSB.NT.Services

[USB_Install.HW]
AddReg=Dev_AddReg

[Dev_AddReg]
HKR,,DeviceInterfaceGUIDs,0x10000,"{A5DCBF10-6530-11D2-901F-00C04FB951ED}"

[Strings]
ManufacturerName="Pacific Image Electronics (Open Source Community)"
DeviceName="PrimeFilm 1800u / 1800i 35mm Film Scanner (WinUSB)"
